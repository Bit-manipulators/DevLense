APP_ENV=development
DATABASE_URL=sqlite:///./devlens.db

# rule_based is the safe default. Set ollama only after configuring a local server.
LLM_PROVIDER=rule_based
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Comma-separated list. Configure your Expo development URL / LAN origin as needed.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081

EXECUTION_TIMEOUT_SECONDS=5
MAX_CODE_SIZE=50000
MAX_OUTPUT_SIZE=10000
MAX_REQUESTS_PER_MINUTE=60
EXECUTION_MEMORY_LIMIT_MB=256
