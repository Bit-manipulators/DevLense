{
  "expo": {
    "name": "DevLens",
    "slug": "devlens",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "devlens",
    "experiments": { "typedRoutes": true },
    "plugins": ["expo-router"],
    "android": {
      "package": "com.devlens.mobile",
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}

